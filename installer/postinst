#!/bin/sh
# postinst .deb: заводит то, чего не может сама служба, — группу доступа к
# сокету и юнит systemd. Сокет 0660 root:proxybox (crates/core-ipc/src/
# unix_socket.rs) служба запирает сама на каждом старте, но `chgrp proxybox`
# на несуществующую группу молча ничего не даёт: пока группы нет, сокетом
# управляет только root, и окно от обычного пользователя до службы не
# достучится. Группа — вот и весь смысл этого скрипта.
set -e

case "$1" in
  configure)
    # -r: системная группа, не для входа человека. На переустановке и
    # обновлении она уже есть — это не отказ, а норма: dpkg зовёт postinst
    # каждый раз.
    groupadd -r proxybox 2>/dev/null || true

    # Кто ставит пакет из-под sudo, тот и откроет окно первым; без членства в
    # группе оно запустится, но до сокета службы не достучится никогда.
    # root добавлять в свою же группу незачем, а `sudo -u` без входа под
    # своим пользователем SUDO_USER не задаёт вовсе.
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
      usermod -aG proxybox "$SUDO_USER" || true
    fi

    # В контейнере и в chroot systemd не поднят (нет /run/systemd/system), и
    # systemctl там либо не работает, либо бьёт по чужому init внутри сборки
    # образа. Юнит-файл кладёт `files` в tauri.conf.json, а тут его только
    # включают.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      # Неудавшийся автозапуск (например, nftables ещё не настроен на этой
      # машине) не должен валить установку пакета целиком — это тише, чем
      # оставить систему с наполовину поставленным proxybox.
      systemctl enable --now proxybox || true
    fi
    ;;
esac

exit 0
