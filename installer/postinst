#!/bin/sh
# postinst .deb: заводит то, чего не может сама служба, — группу доступа к
# сокету и юнит systemd, и следом перезапускает или включает саму службу.
# Сокет 0660 root:proxybox (crates/core-ipc/src/unix_socket.rs) служба
# запирает сама на каждом старте, но `chgrp proxybox` на несуществующую
# группу молча ничего не даёт: пока группы нет, сокетом управляет только
# root, и окно от обычного пользователя до службы не достучится.
set -e

case "$1" in
  configure)
    # -r: системная группа, не для входа человека. На переустановке и
    # обновлении она уже есть — это не отказ, а норма: dpkg зовёт postinst
    # каждый раз.
    groupadd -r proxybox 2>/dev/null || true

    # Кто ставит пакет из-под sudo, тот и откроет окно первым; без членства в
    # группе оно запустится, но до сокета службы не достучится никогда.
    # root добавлять в свою же группу незачем, а `sudo -u` без входа под
    # своим пользователем SUDO_USER не задаёт вовсе.
    #
    # SUDO_USER пуст не только под root: то же самое видят GNOME Software,
    # gdebi, pkexec, `su -` и автообновление — то есть ровно те пути, которыми
    # ставит пакет обычный человек, а не только «sudo apt install» из
    # терминала. Молчание тут хуже отказа: единственная причина заводить
    # группу — впустить в неё живого человека, а без сообщения ниже это
    # осталось бы незамеченным до первого «не могу подключиться к службе».
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
      usermod -aG proxybox "$SUDO_USER" || true
      echo "proxybox: добавили пользователя $SUDO_USER в группу proxybox — доступ к службе появится после следующего входа в систему"
    else
      echo "proxybox: добавить себя в группу proxybox некому автоматически (не sudo) — выполните: sudo usermod -aG proxybox \"\$USER\" и войдите в систему заново"
    fi

    # В контейнере и в chroot systemd не поднят (нет /run/systemd/system), и
    # systemctl там либо не работает, либо бьёт по чужому init внутри сборки
    # образа. Юнит-файл кладёт `files` в tauri.conf.json, а тут его только
    # включают.
    if [ -d /run/systemd/system ]; then
      # `-d /run/systemd/system` не исчерпывающая проверка (каталог бывает и
      # там, где systemd не PID 1), поэтому и сам daemon-reload — под своим
      # `|| true`, как соседние вызовы: без него это единственная команда
      # блока, падение которой при `set -e` валит postinst и оставляет пакет
      # в `iF` (полунастроенным) на ровном месте.
      systemctl daemon-reload || true
      # enable --now идёт первым и безусловно — так делает debhelper, и по той
      # же причине. `$2` (configversion) обнуляет только purge, а `apt remove`
      # оставляет пакет в состоянии `rc`; dpkg передаёт его же вторым
      # аргументом при переустановке (deferred_configure), так что после
      # обычного `apt remove && apt install` `$2` оказывается непустым — и
      # старая логика звала бы только `try-restart`, который по определению
      # ничего не делает с юнитом, уже выключенным `postrm` (`systemctl
      # disable --now`). Итог был молчаливым: пакет стоит, служба мертва.
      # `enable --now` на уже включённом и живом юните — no-op, так что на
      # обновлении она ничего не портит, а следующий `try-restart` спокойно
      # подхватывает новый образ на диске. Заодно чинится второй сценарий:
      # если самый первый `enable --now` когда-то не удался (nftables ещё не
      # настроен) и проглотился через `|| true`, теперь его повторяет каждая
      # следующая настройка пакета, а не только первая установка.
      systemctl enable --now proxybox || true
      if [ -n "$2" ]; then
        # Обновление поверх уже стоящего пакета: юнит уже запущен со старым
        # образом на диске, а `enable --now` живой юнит не перезапускает.
        # Контракт core-ipc пополняется молча (рукопожатия версий нет), и
        # старая служба может не знать команду, которую тут же пришлёт новое
        # окно. Тот же размен, что и на Windows (`net stop` в
        # NSIS_HOOK_PREINSTALL): замок на секунду снимается при перезапуске.
        systemctl try-restart proxybox || true
      fi
    fi
    ;;
esac

exit 0
