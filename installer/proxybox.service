[Unit]
Description=proxybox — сеть выбранным приложениям только через туннель
# Замок ставится в nftables, туннель поднимается через TUN: без сети
# стартовать можно, без ядра — нет.
After=network.target
Wants=network.target

[Service]
Type=simple
# Без nft guard(true) не откажет — linux::apply вернёт NotFound, applied
# останется None, а sing-box поднимется как ни в чём не бывало: сеть без
# замка вовсе, и молча. Лучше не стартовать, чем стартовать без
# единственного механизма, ради которого служба вообще нужна.
ExecStartPre=/bin/sh -c 'command -v nft >/dev/null'
ExecStart=/usr/bin/pg-service
# sing-box не лежит рядом с pg-service в /usr/bin: этот путь занят
# официальным .deb от SagerNet, и install.md больше не будет мириться с
# конфликтом. Бинарник кладём отдельно в /usr/lib/proxybox, и переменной
# здесь для этого нет: core_tunnel::binary() сам знает этот путь последним
# запасным шагом (после PG_SINGBOX, настройки и поиска рядом с pg-service),
# так что находит sing-box и служба, и `proxybox doctor`, запущенный руками
# без systemd. Раньше этот же путь называла переменная окружения юнита, и
# это стоило двух неприятностей разом: она писала в журнал «настройки
# перебиты окружением» на каждом старте службы и не была видна вызову без
# юнита.
# Права настоящие: TUN и nftables от обычного пользователя не работают.
# Урезание до CAP_NET_ADMIN — отдельным шагом после проверки на живой машине.
User=root
Restart=on-failure
RestartSec=2
# Остановка обязана быть по SIGTERM: снятие правил висит на обработчике.
# Убитая KILL служба оставит машину с запертым исходящим до следующего старта.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
