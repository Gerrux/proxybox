#!/bin/sh
# postrm .deb: снимает то, что завёл postinst, — юнит и его состояние в
# systemd. Группу `proxybox` не трогаем нарочно: в ней остались люди, и
# удаление на обновлении (postrm старой версии зовётся с `upgrade`, не с
# `remove`) отобрало бы у них доступ к сокету между установкой новой версии
# и её собственным postinst.
set -e

case "$1" in
  remove)
    if [ -d /run/systemd/system ]; then
      # К этому моменту dpkg уже удалил сам юнит-файл — `disable` работает и
      # без него: systemd убирает висящие симлинки автозапуска по имени
      # юнита, не читая исчезнувший [Install]. `--now` гасит ещё и живой
      # процесс, если служба почему-то не была остановлена раньше.
      systemctl disable --now proxybox 2>/dev/null || true
      systemctl daemon-reload || true
    fi
    ;;
esac

# Страховка C2: замок снимает prerm (штатный SIGTERM службе), пока юнит и
# бинарники ещё на месте. Если это не удалось — пакет без prerm (обновление
# со старой версии), SIGKILL по TimeoutStopSec, служба уже не значилась в
# SCM, — таблица осталась бы в ядре и заперла машину без исходящей сети до
# перезагрузки. Снять её отсюда напрямую безопасно: таблица наша единолично
# (сторож `the_lock_never_touches_a_foreign_table`), чужой политики она не
# трогает, и `nft` транзакционен — сиротам просто негде накопиться.
# На purge, в отличие от systemctl-веток выше, тоже нужна: purge вызывает
# postrm ещё раз уже после remove, и это тот же самый шанс подстраховаться,
# если первый не сработал.
case "$1" in
  remove | purge)
    if command -v nft >/dev/null 2>&1 && nft list table inet proxybox >/dev/null 2>&1; then
      nft delete table inet proxybox || true
    fi
    ;;
esac

exit 0
