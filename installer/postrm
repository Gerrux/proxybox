#!/bin/sh
# postrm .deb: снимает то, что завёл postinst, — юнит и его состояние в
# systemd, — а на purge ещё и каталог состояния службы. Группу `proxybox` не
# трогаем нарочно: в ней остались люди, и удаление на обновлении (postrm
# старой версии зовётся с `upgrade`, не с `remove`) отобрало бы у них доступ
# к сокету между установкой новой версии и её собственным postinst.
set -e

case "$1" in
  remove)
    if [ -d /run/systemd/system ]; then
      # К этому моменту dpkg уже удалил сам юнит-файл — `disable` работает и
      # без него: systemd убирает висящие симлинки автозапуска по имени
      # юнита, не читая исчезнувший [Install]. `--now` гасит ещё и живой
      # процесс, если служба почему-то не была остановлена раньше.
      systemctl disable --now proxybox 2>/dev/null || true
      systemctl daemon-reload || true
    fi
    ;;
esac

# Страховка C2: замок снимает prerm (штатный SIGTERM службе), пока юнит и
# бинарники ещё на месте. Если это не удалось — пакет без prerm (обновление
# со старой версии), SIGKILL по TimeoutStopSec, служба уже не значилась в
# SCM, — таблица осталась бы в ядре и заперла машину без исходящей сети до
# перезагрузки. Снять её отсюда напрямую безопасно: таблица наша единолично
# (сторож `the_lock_never_touches_a_foreign_table`), чужой политики она не
# трогает, и `nft` транзакционен — сиротам просто негде накопиться.
# На purge, в отличие от systemctl-веток выше, тоже нужна: purge вызывает
# postrm ещё раз уже после remove, и это тот же самый шанс подстраховаться,
# если первый не сработал.
case "$1" in
  remove | purge)
    if command -v nft >/dev/null 2>&1 && nft list table inet proxybox >/dev/null 2>&1; then
      nft delete table inet proxybox || true
    fi
    ;;
esac

# Только purge, а не remove: remove обязан оставить данные на месте —
# человек ставит пакет обратно и ждёт свои профили, подписки и список
# приложений там же, где оставил (см. `settle()` в pg-service — тот же
# каталог переживает даже переименование пакета). Смешать эти две ветки
# здесь дороже, чем где бы то ни было ещё в этом файле.
#
# А вот purge Debian policy как раз и заводили ради этого: после него от
# пакета не должно остаться ни настроек, ни данных. Для продукта про
# приватность это не формальность — `/var/lib/proxybox/state.json` хранит
# пароли и ключи ВСЕХ профилей человека, рядом лежат собранный `singbox.json`
# и `singbox.log`. Оставить их после purge значило бы, что «удалили всё»
# на самом деле оставило все ключи на диске — прямое противоречие тому, что
# продукт обещает.
#
# Путь захардкожен, а не вычислен через `core_ipc`/`pg-service`: переменные
# окружения человека (XDG_CONFIG_HOME) maintainer-скрипту недоступны, и
# гадать про них нельзя, — но служба всегда root, а `base_dir()` под root без
# переменной (так и приходит из systemd) безусловно возвращает `/var/lib`
# (crates/pg-service/src/main.rs). `rm -rf` не падает на отсутствующем
# каталоге — службу могли ни разу не запустить, и это не ошибка purge, а
# нормальный случай.
case "$1" in
  purge)
    rm -rf /var/lib/proxybox
    ;;
esac

exit 0
