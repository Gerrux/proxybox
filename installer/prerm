#!/bin/sh
# prerm .deb: первая (и правильная) попытка снять замок — пока служба, юнит и
# бинарники ещё на диске. Замок — таблица nftables (crates/core-filter/src/
# linux.rs), и снимает её только обработчик SIGTERM самой службы; без этого
# шага dpkg на `apt remove` сразу удаляет юнит и файлы, systemd глушит службу
# уже несуществующим бинарником, а до SIGTERM дело может и не дойти.
# `systemctl stop` посылает штатный SIGTERM и ждёт до TimeoutStopSec — то есть
# ровно то же самое, что происходит при обычной остановке машины.
#
# postrm вдобавок подчищает таблицу напрямую через `nft delete table` — это
# подстраховка на случай, если этот скрипт вообще не позвали (пакет без
# prerm, обновление со старой версии) или сама остановка не уложилась в
# отведённые секунды и systemd добил службу SIGKILL.
set -e

case "$1" in
  remove)
    if [ -d /run/systemd/system ]; then
      systemctl stop proxybox 2>/dev/null || true
    fi
    ;;
esac

exit 0
