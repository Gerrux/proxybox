<!-- Windows Sandbox config template. run.ps1 substitutes the three
     double-brace placeholders below with absolute host paths and arguments. -->
<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>{{STAGE}}</HostFolder>
      <SandboxFolder>C:\pb</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>{{OUT}}</HostFolder>
      <SandboxFolder>C:\pb-out</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe {{ARGS}}</Command>
  </LogonCommand>
</Configuration>
