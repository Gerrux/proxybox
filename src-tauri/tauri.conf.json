{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proxybox",
  "version": "0.3.2",
  "identifier": "ru.proxybox.desktop",
  "build": {
    "frontendDist": "../ui/app-shell/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter app-shell dev",
    "beforeBuildCommand": "pnpm --filter app-shell build"
  },
  "app": {
    "windows": [
      {
        "title": "proxybox",
        "width": 1000,
        "height": 700,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ws://127.0.0.1:5173 http://127.0.0.1:5173 https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Выбранные приложения — только через туннель",
    "longDescription": "Контроль исходящего трафика: выбранные приложения ходят в сеть только через туннель пользователя, а без туннеля не ходят вовсе.",
    "publisher": "proxybox",
    "externalBin": [
      "binaries/pg-service",
      "binaries/proxybox",
      "binaries/sing-box"
    ],
    "resources": [
      "binaries/LICENSE-sing-box.txt"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../installer/hooks.nsh",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}